{
	"name": "risuko",
	"version": "0.7.0",
	"description": "A full-featured download manager",
	"homepage": "https://risuko.app",
	"author": {
		"name": "YueMiyuki",
		"email": "yuemiyuki4737@gmail.com"
	},
	"copyright": "Copyright© YueMiyuki",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/YueMiyuki/Risuko.git"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"dev:renderer": "vite --config vite.renderer.config.ts --mode development --port 9080",
		"pack:renderer": "vite build --config vite.renderer.config.ts --mode production",
		"android:dev": "node scripts/android-env.mjs pnpm exec tauri android dev",
		"android:build": "node scripts/android-env.mjs pnpm exec tauri android build --apk --split-per-abi",
		"android:build:debug": "node scripts/android-env.mjs pnpm exec tauri android build --debug --target aarch64 --apk && pnpm android:sign:debug",
		"android:build:debug:unsigned": "node scripts/android-env.mjs pnpm exec tauri android build --debug --target aarch64 --apk",
		"android:build:signed": "pnpm android:build && pnpm android:sign",
		"android:sign": "node scripts/sign-android-apks.mjs",
		"android:sign:debug": "node scripts/sign-android-apks.mjs --debug",
		"clean:tauri": "node scripts/clean-tauri.mjs",
		"clean:tauri:android": "node scripts/clean-tauri.mjs --android",
		"clean:tauri:full": "node scripts/clean-tauri.mjs --full",
		"fmt": "pnpx @biomejs/biome check --write --max-diagnostics none",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json",
		"check:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
		"knip": "pnpx knip --fix",
		"pre-commit": "pnpm typecheck && pnpm check:i18n && pnpm fmt",
		"prepare": "pnpx husky",
		"risuko": "node packages/risuko-cli/bin.js"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@lucide/vue": "^1.37.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-barcode-scanner": "^2.4.5",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-deep-link": "^2.4.9",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@vueuse/core": "^14.4.0",
		"cnfast": "^0.1.0",
		"motion-v": "^2.4.0",
		"qrcode": "^1.5.4",
		"reka-ui": "^2.10.4",
		"tw-animate-css": "^1.4.0",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@bany/curl-to-json": "^1.2.10",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.4.0",
		"@types/qrcode": "^1.5.6",
		"@vitejs/plugin-vue": "^6.0.8",
		"axios": "^1.20.0",
		"cfonts": "^3.3.1",
		"chalk": "^6.0.0",
		"i18next": "^26.4.0",
		"lodash": "^4.18.1",
		"pinia": "^4.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "^8.2.2",
		"vue": "^3.5.42",
		"vue-router": "^5.3.0",
		"vue-tsc": "^3.3.11",
		"vue-virtual-scroller": "3.0.5"
	},
	"packageManager": "pnpm@11.3.0"
}
